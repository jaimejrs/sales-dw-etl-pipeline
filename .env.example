# URLs completas de conexão
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco_origem
DW_DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco_dw

# Timeout de conexão em segundos
DB_CONNECT_TIMEOUT=10

# Estratégia de carga: auto, full ou incremental
DW_LOAD_MODE=auto

# Janela usada no incremental: reprocessa MAX(data_venda) - N dias
DW_INCREMENTAL_LOOKBACK_DAYS=30
